local CoreGui = game:GetService("CoreGui")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

pcall(function()
    local old = CoreGui:FindFirstChild("KAKA_TIMER")
    if old then old:Destroy() end
end)

local gui = Instance.new("ScreenGui")
gui.Name = "KAKA_TIMER"
gui.ResetOnSpawn = false
gui.Parent = (gethui and gethui()) or CoreGui

local color = Color3.fromRGB(145,75,255)
local seconds = 300
local running = false
local rainbow = false
local minimized = false
local scaleValue = 1
local alive = true

local main = Instance.new("Frame",gui)
main.Size = UDim2.fromOffset(320,390)
main.Position = UDim2.new(.5,-160,.5,-195)
main.BackgroundColor3 = Color3.fromRGB(20,20,32)
main.BorderSizePixel = 0
Instance.new("UICorner",main).CornerRadius=UDim.new(0,15)

local stroke=Instance.new("UIStroke",main)
stroke.Color=color
stroke.Thickness=2

local scaler=Instance.new("UIScale",main)

local function makeButton(text,x,y,w,callback)
    local b=Instance.new("TextButton",main)
    b.Size=UDim2.fromOffset(w,36)
    b.Position=UDim2.fromOffset(x,y)
    b.BackgroundColor3=color
    b.Text=text
    b.TextColor3=Color3.new(1,1,1)
    b.TextSize=13
    b.Font=Enum.Font.GothamBold
    b.BorderSizePixel=0
    Instance.new("UICorner",b).CornerRadius=UDim.new(0,8)
    b.MouseButton1Click:Connect(callback)
    return b
end

-- HEADER
