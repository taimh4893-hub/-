local timer = Instance.new("TextLabel")
timer.Size = UDim2.new(1,-30,0,80)
timer.Position = UDim2.fromOffset(15,65)
timer.BackgroundColor3 = Color3.fromRGB(35,35,55)
timer.TextColor3 = Color3.new(1,1,1)
timer.TextScaled = true
timer.Font = Enum.Font.GothamBold
timer.Parent = frame
Instance.new("UICorner",timer).CornerRadius = UDim.new(0,12)

local input = Instance.new("TextBox")
input.Size = UDim2.new(1,-30,0,42)
input.Position = UDim2.fromOffset(15,155)
input.BackgroundColor3 = Color3.fromRGB(40,40,60)
input.TextColor3 = Color3.new(1,1,1)
input.PlaceholderText = "Enter minutes..."
input.Text = "60"
input.TextScaled = true
input.ClearTextOnFocus = false
input.Parent = frame
Instance.new("UICorner",input).CornerRadius = UDim.new(0,10)

local seconds = 0
local running = false
local alive = true

local function update()
    local h = math.floor(seconds/3600)
    local m = math.floor(seconds%3600/60)
    local s = math.floor(seconds%60)
    timer.Text = string.format("%02d:%02d:%02d",h,m,s)
end

local start = makeButton(frame,"▶ START SUBATHON",15,210,175,45)
local pause = makeButton(frame,"⏸ PAUSE",200,210,175,45)
local reset = makeButton(frame,"🔄 RESET",15,265,360,40)
local menuButton = makeButton(frame,"➕ OPEN ADD TIME MENU",15,315,360,42)

local menu = Instance.new("Frame")
menu.Size = UDim2.fromOffset(350,205)
menu.Position = UDim2.new(0.5,-175,0.5,-102)
menu.BackgroundColor3 = Color3.fromRGB(25,25,40)
menu.Visible = false
menu.Parent = gui
Instance.new("UICorner",menu).CornerRadius = UDim.new(0,16)

local menuStroke = Instance.new("UIStroke",menu)
menuStroke.Thickness = 3

local menuTitle = Instance.new("TextLabel")
menuTitle.Size = UDim2.new(1,0,0,40)
menuTitle.BackgroundTransparency = 1
menuTitle.Text = "🌈 ADD SUBATHON TIME"
menuTitle.TextColor3 = Color3.new(1,1,1)
menuTitle.TextScaled = true
menuTitle.Parent = menu

local function addButton(text,amount,x,y)
    local b = makeButton(menu,text,x,y,155,43)
    b.Activated:Connect(function()
        seconds = seconds + amount
        update()
    end)
end

addButton("+10 Seconds",10,12,48)
addButton("+1 Minute",60,182,48)
addButton("+5 Minutes",300,12,100)
addButton("+1 Hour",3600,182,100)
addButton("+10 Hours",36000,12,152)

local menuClose = makeButton(menu,"CLOSE",182,152,155,43)
menuClose.Activated:Connect(function()
    menu.Visible = false
end)

start.Activated:Connect(function()
    local mins = tonumber(input.Text)
    if mins and mins > 0 then
        seconds = math.floor(mins*60)
        running = true
        update()
    end
end)

pause.Activated:Connect(function()
    running = false
end)

reset.Activated:Connect(function()
    running = false
    seconds = 0
    update()
end)

menuButton.Activated:Connect(function()
    menu.Visible = not menu.Visible
end)

local hue = 0
local connection = RunService.Heartbeat:Connect(function(dt)
    if not alive then return end

    hue = (hue + dt*0.2)%1
    local color = Color3.fromHSV(hue,1,1)
    stroke.Color = color
    menuStroke.Color = color

    if running then
        seconds = math.max(0,seconds-dt)
        if seconds <= 0 then running = false end
        update()
    end
end)

close.Activated:Connect(function()
    alive = false
    connection:Disconnect()
    gui:Destroy()
end)

-- Drag main window with touch
local dragging = false
local dragStart, startPos

title.InputBegan:Connect(function(inputObject)
    if inputObject.UserInputType == Enum.UserInputType.Touch
    or inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = inputObject.Position
        startPos = frame.Position
    end
end)

UIS.InputChanged:Connect(function(inputObject)
    if dragging and (
        inputObject.UserInputType == Enum.UserInputType.Touch
        or inputObject.UserInputType == Enum.UserInputType.MouseMovement
    ) then
        local delta = inputObject.Position-dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale,startPos.X.Offset+delta.X,
            startPos.Y.Scale,startPos.Y.Offset+delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(inputObject)
    if inputObject.UserInputType == Enum.UserInputType.Touch
    or inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

